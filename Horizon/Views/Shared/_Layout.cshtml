    <script>
        $(document).ready(function () {
            // Initialize feather icons
            feather.replace();

            // Success message handling
            if (window.location.href.includes('success') || new URLSearchParams(window.location.search).has('success')) {
                $('#feedback')
                    .addClass('alert-success show')
                    .text('تم حفظ البيانات بنجاح');
                setTimeout(function () {
                    $('#feedback').removeClass('show');
                }, 3000);
            }

            // Sidebar toggle functionality with localStorage support
            const SIDEBAR_STATE_KEY = 'horizon_sidebar_state';
            const MENU_STATES_KEY = 'horizon_menu_states';

            // Get saved state from localStorage (desktop only)
            function getSavedSidebarState() {
                if (!isMobile()) {
                    const saved = localStorage.getItem(SIDEBAR_STATE_KEY);
                    return saved !== null ? JSON.parse(saved) : true; // Default to open
                }
                return false; // Mobile always starts closed
            }

            // Save sidebar state to localStorage (desktop only)
            function saveSidebarState(isOpen) {
                if (!isMobile()) {
                    localStorage.setItem(SIDEBAR_STATE_KEY, JSON.stringify(isOpen));
                }
            }

            // Get saved menu states from localStorage
            function getSavedMenuStates() {
                const saved = localStorage.getItem(MENU_STATES_KEY);
                return saved !== null ? JSON.parse(saved) : {};
            }

            // Save menu states to localStorage
            function saveMenuStates() {
                const menuStates = {};
                $('.collapse').each(function () {
                    const menuId = $(this).attr('id');
                    if (menuId) {
                        menuStates[menuId] = $(this).hasClass('show');
                    }
                });
                localStorage.setItem(MENU_STATES_KEY, JSON.stringify(menuStates));
            }

            // Restore menu states from localStorage
            function restoreMenuStates() {
                const savedStates = getSavedMenuStates();
                Object.keys(savedStates).forEach(function (menuId) {
                    const $menu = $('#' + menuId);
                    const $trigger = $('[data-bs-target="#' + menuId + '"]');

                    if (savedStates[menuId]) {
                        // Open the menu
                        $menu.addClass('show');
                        $trigger.removeClass('collapsed').attr('aria-expanded', 'true');
                    } else {
                        // Close the menu
                        $menu.removeClass('show');
                        $trigger.addClass('collapsed').attr('aria-expanded', 'false');
                    }
                });
            }

            let sidebarOpen = getSavedSidebarState();

            // Function to check if we're on mobile
            function isMobile() {
                return window.innerWidth < 768; // md breakpoint
            }

            // Function to reset sidebar state on window resize
            function handleResize() {
                if (!isMobile()) {
                    // Desktop: Apply saved state or default to open
                    const savedState = getSavedSidebarState();
                    if (savedState) {
                        $('#app-layout-content').css('margin-right', '15.625rem');
                        $('.navbar-vertical').css('margin-right', '0px');
                    } else {
                        $('#app-layout-content').css('margin-right', '0');
                        $('.navbar-vertical').css('margin-right', '-15.625rem');
                    }
                    $('#sidebar-overlay').hide();
                    sidebarOpen = savedState;
                } else {
                    // Mobile: Reset to closed state
                    $('#app-layout-content').css('margin-right', '0');
                    $('.navbar-vertical').css('margin-right', '-15.625rem');
                    $('#sidebar-overlay').hide();
                    sidebarOpen = false;
                }
            }

            // Initialize sidebar state based on screen size
            handleResize();

            // Restore menu states after sidebar is initialized
            restoreMenuStates();

            // Handle window resize
            $(window).on('resize', handleResize);

            // Toggle button click handler
            $('#nav-toggle').on('click', function (e) {
                e.preventDefault();

                if (isMobile()) {
                    // Mobile behavior: toggle sidebar with overlay (no saving)
                    if (sidebarOpen) {
                        // Close sidebar
                        $('.navbar-vertical').css('margin-right', '-15.625rem');
                        $('#sidebar-overlay').hide();
                        sidebarOpen = false;
                    } else {
                        // Open sidebar
                        $('.navbar-vertical').css('margin-right', '0px');
                        $('#sidebar-overlay').show();
                        sidebarOpen = true;
                    }
                } else {
                    // Desktop behavior: toggle content margin and save state
                    if (sidebarOpen) {
                        // Hide sidebar
                        $('#app-layout-content').css('margin-right', '0');
                        $('.navbar-vertical').css('margin-right', '-15.625rem');
                        sidebarOpen = false;
                        saveSidebarState(false);
                    } else {
                        // Show sidebar
                        $('#app-layout-content').css('margin-right', '15.625rem');
                        $('.navbar-vertical').css('margin-right', '0px');
                        sidebarOpen = true;
                        saveSidebarState(true);
                    }
                }
            });

            // Overlay click handler (mobile only)
            $('#sidebar-overlay').on('click', function () {
                if (isMobile() && sidebarOpen) {
                    $('.navbar-vertical').css('margin-right', '-15.625rem');
                    $('#sidebar-overlay').hide();
                    sidebarOpen = false;
                }
            });

            // Listen for Bootstrap collapse events to save menu states
            $('.collapse').on('shown.bs.collapse hidden.bs.collapse', function () {
                saveMenuStates();
            });

            // Handle menu item clicks to save states
            $('[data-bs-toggle="collapse"]').on('click', function () {
                // Small delay to ensure Bootstrap has processed the toggle
                setTimeout(function () {
                    saveMenuStates();
                }, 100);
            });

            // Set active menu item based on current URL
            function setActiveMenuItem() {
                const currentPath = window.location.pathname.toLowerCase();

                // Remove active class from all nav links
                $('.nav-link').removeClass('active');

                // Find and activate the matching menu item
                $('.nav-link').each(function () {
                    const href = $(this).attr('href');
                    if (href && href !== '#!' && href !== '#') {
                        const linkPath = href.replace('~', '').toLowerCase();
                        if (currentPath.includes(linkPath) ||
                            (linkPath.includes('?') && currentPath.includes(linkPath.split('?')[0]))) {
                            $(this).addClass('active');

                            // If this is a submenu item, expand its parent
                            const $parentCollapse = $(this).closest('.collapse');
                            if ($parentCollapse.length) {
                                const parentId = $parentCollapse.attr('id');
                                const $trigger = $('[data-bs-target="#' + parentId + '"]');

                                $parentCollapse.addClass('show');
                                $trigger.removeClass('collapsed').attr('aria-expanded', 'true');

                                // Save the updated state
                                setTimeout(function () {
                                    saveMenuStates();
                                }, 100);
                            }
                            return false; // Break out of each loop
                        }
                    }
                });
            }

            // Set active menu item on page load
            setActiveMenuItem();
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>